<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- BiometricPrompt in KeystorePlugin. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- androidx.biometric's FingerprintManager fallback is for API 28 and below; minSdk is 30. -->
    <uses-permission android:name="android.permission.USE_FINGERPRINT" tools:node="remove" />
    <!-- Only Enrollment String registration goes online; codes are generated offline. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- QR code scanning; requested only when the user taps Scan, and optional so devices
         without a camera can still install the app. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false"
        tools:replace="android:required" />
    <!-- The camera plugin declares these for video recording, which scanning never does. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="remove" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="remove" />
    <!-- Implied by the camera plugin's storage declaration; photos come through the system picker. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove" />
    <!-- From the image picker's video support, which this app never uses. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <!-- allowBackup="false" per flutter_secure_storage's README ("Disabling
         Auto Backup"): a restored backup can't be decrypted on a new device,
         and the data must not leave this device anyway. Some OEMs still run
         device-to-device transfer on Android 12+ despite allowBackup="false",
         so the explicit exclusion rules below cover that path too. -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:label="SimplePASS"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <!-- The image picker's hint asking Google Play services to install its backported photo
             picker. Android 11-12 devices without a photo picker use the system file picker instead. -->
        <service
            android:name="com.google.android.gms.metadata.ModuleDependencies"
            tools:node="remove" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
