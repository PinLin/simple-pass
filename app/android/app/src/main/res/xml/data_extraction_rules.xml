<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: keep flutter_secure_storage's shared preferences out of both
     cloud backup and device-to-device transfer; its wrapped key can't be
     unwrapped on another device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
